# Dependencias
node_modules/

# Compilado
dist/
*.tsbuildinfo

# Entorno y secretos
.env
.env.*
!.env.example

# Sistema operativo
.DS_Store
Thumbs.db

# Editores
.vscode/*
!.vscode/extensions.json
.idea/

# Registros
npm-debug.log*
yarn-error.log*

# ============================================================================
# DATOS PERSONALES — NUNCA en el control de versiones
# ----------------------------------------------------------------------------
# La nómina oficial tiene nombres y correos de alumnos, menores de edad.
# Vive solo en los computadores del Centro de Alumnos.
# Si falta, la app arranca con la nómina de demostración (roster.demo.ts).
# ============================================================================
src/content/roster.ts
# Mismo motivo: el volcado de la nomina para la base de datos.
supabase/03-nomina.sql
# Y el archivo donde se escriben los correos del equipo que entra primero.
supabase/05-lanzamiento.sql

# La llave privada de las notificaciones. Va en Supabase, no aqui.
supabase/vapid.txt

# NOTA: `src/content/seed/contenido.json` SÍ se versiona a propósito.
# Es el contenido oficial del Centro de Alumnos (noticias, comunicados,
# eventos…), o sea, trabajo que hay que respaldar y que debe llegar a la
# versión publicada. No es un dato personal como la nómina.

# Estado que deja el CLI de Supabase al enlazar el proyecto. Es de esta
# maquina, no del proyecto.
supabase/.temp/

# Capturas para las tiendas. Se regeneran con scripts/capturas.mjs y pueden
# llevar contenido real, incluidos nombres de estudiantes.
capturas/
scripts/.sesion.json

# Contenido exportado desde el panel. Lleva el nombre y el curso de cada
# persona que publico algo, y este repositorio es publico. La app en
# produccion siempre corre con el servidor, asi que este archivo solo actua de
# respaldo local: sacarlo de Git no le quita nada a nadie.
src/content/seed/contenido.json
